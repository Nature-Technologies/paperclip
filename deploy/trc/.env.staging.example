# TRC staging environment for paperclip.
#
# NOTHING READS THIS FILE AT DEPLOY TIME. It is documentation, plus a fixture
# for deploy/trc/validate_compose.py.
#
# The deploy workflow (.github/workflows/trc-staging-deploy.yml) no longer
# renders a `.env.staging` at all. Its `Deploy` step binds every one of these
# variables as its own `env:`, and Compose resolves the compose file's ${...}
# references straight out of that process environment. So no secret is written
# to disk -- not on the runner, not on the staging host -- and because nothing
# is dotenv-parsed, a `$`, a backtick or a `#` inside a secret is taken
# literally instead of being interpolated or truncated. That is why the charset
# guard the rendered file used to need is gone; see the header of the workflow.
#
# The validator reads only the KEYS below, filling each with a placeholder to
# prove `docker compose config` renders and that the `${VAR:?}` guards fire. It
# asserts this list covers every variable the compose file references, AND that
# the workflow's `Deploy` step `env:` covers the same set -- an omission from
# either is a broken deploy. The values below are illustrative.
#
# If you ever need to run this stack by hand, copy this file to `.env.staging`,
# fill it in, and pass it with `--env-file`. Delete it afterwards: the
# workflow has no cleanup step any more, precisely because it never creates
# one of these.

# Image to deploy. The workflow BUILDS this image ON THE DEPLOY HOST and tags
# it twice in that host's local image store: the moving `:staging` pointer and
# the IMMUTABLE `:git-<7-char-sha>` naming the exact commit built. Nothing is
# pushed to a registry -- the compose service sets `pull_policy: never` so a
# missing image fails closed rather than falling back to GHCR, where the
# retired publish-then-pull scheme left tags a rollback could start by
# accident. `PAPERCLIP_IMAGE` is the `:git-<7>` tag, never `:staging`, so "what
# is running" is unambiguous and cannot be changed under the deploy by a later,
# unrelated run.
#
# ROLLBACK TARGETS ARE HOST-LOCAL now: a `docker image prune -a` on the staging
# host destroys every one of them. See docs/deploy/trc-staging.md, which
# dispatches from a throwaway branch with the `PAPERCLIP_IMAGE` env line of the
# `Deploy` step hardcoded to an older `:git-<7>` tag.
#
# The image is built with `target: production` -- the Dockerfile declares a
# later `cloud` stage that this stack never deploys.
PAPERCLIP_IMAGE=ghcr.io/nature-technologies/trc-paperclip:git-f070113

# Secret. Postgres is unreachable from the host, so moving this off the old
# hardcoded "paperclip" is hardening rather than a fix. The same value is
# interpolated into DATABASE_URL, so both come from this one variable -- which
# is why the workflow still rejects `@ : / ? #` in it even though the generic
# charset guard is gone: those characters corrupt a connection string, which is
# a URL problem rather than a parsing one.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Secrets.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
#   openssl rand -hex 32
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Secret, shared with trc-hermes-agent but for an independent consumer, so no
# cross-check is needed.
OPENROUTER_API_KEY=

# The real external URL a browser can reach -- scheme, host and port as seen
# from OUTSIDE the host, e.g. http://<server-host>:3100, or the https:// origin
# if it sits behind a proxy. Baked into auth callbacks and shown to the first
# admin. A localhost value is wrong on a server.
PAPERCLIP_PUBLIC_URL=

# Absolute host path for Paperclip's instance data, bind-mounted at /paperclip.
# Holds secrets/master.key and the instance config.json that carries the
# hermes_gateway wiring -- treat it as irreplaceable. Must be owned by UID 1000
# (`node`), because bind mounts carry host ownership straight through and the
# container does not run as root. Resolved by the REMOTE daemon, so it must be
# absolute and must already exist on the server.
PAPERCLIP_HOME_DIR=/srv/trc/staging/paperclip-home

# Host bind address. Reachable on any host interface by default.
PAPERCLIP_BIND=0.0.0.0
