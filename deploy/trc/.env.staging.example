# TRC staging environment for paperclip.
#
# The deploy workflow (.github/workflows/trc-staging-deploy.yml) renders the
# real .env.staging from repository secrets and passes it to `docker compose`
# via --env-file. That file stays on the CI runner and is never copied to the
# server -- the local Compose CLI reads it and sends the values to the remote
# daemon (over the deploy's Docker context) as container environment. This
# file is documentation and is also parsed by deploy/trc/validate_compose.py,
# which fills each key with a placeholder to prove `docker compose config`
# renders. Every variable the compose file references must be listed here.

# Moving-tag image. Written by the deploy workflow as
# ${IMAGE_REPO}:${IMAGE_TAG} (see trc-staging-deploy.yml's `env:` block, which
# defaults IMAGE_TAG to `dev`) -- trc-publish.yml republishes that tag on every
# push to `dev`. There is no digest input any more: to roll back, follow the
# procedure in docs/deploy/trc-staging.md, which dispatches the deploy from a
# throwaway branch rather than committing an IMAGE_TAG change to `dev`. The repository
# was renamed from `paperclip` to `trc-paperclip`; trc-publish.yml derives the
# GHCR package from `github.repository`, so current and future builds land
# under `trc-paperclip`. The old `paperclip` package is frozen history and is
# not used here.
PAPERCLIP_IMAGE=ghcr.io/nature-technologies/trc-paperclip:dev

# Secret. Postgres is unreachable from the host, so moving this off the old
# hardcoded "paperclip" is hardening rather than a fix. The same value is
# interpolated into DATABASE_URL, so both come from this one variable.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Secrets.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
#   openssl rand -hex 32
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Secret, shared with trc-hermes-agent but for an independent consumer, so no
# cross-check is needed.
OPENROUTER_API_KEY=

# The real external URL a browser can reach -- scheme, host and port as seen
# from OUTSIDE the host, e.g. http://<server-host>:3100, or the https:// origin
# if it sits behind a proxy. Baked into auth callbacks and shown to the first
# admin. A localhost value is wrong on a server.
PAPERCLIP_PUBLIC_URL=

# Absolute host path for Paperclip's instance data, bind-mounted at /paperclip.
# Holds secrets/master.key and the instance config.json that carries the
# hermes_gateway wiring -- treat it as irreplaceable. Must be owned by UID 1000
# (`node`), because bind mounts carry host ownership straight through and the
# container does not run as root.
PAPERCLIP_HOME_DIR=/srv/trc/staging/paperclip-home

# Host bind address. Reachable on any host interface by default.
PAPERCLIP_BIND=0.0.0.0
