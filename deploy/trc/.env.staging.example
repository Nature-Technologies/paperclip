# TRC staging environment for paperclip.
#
# The deploy workflow (.github/workflows/trc-staging-deploy.yml) renders the
# real .env.staging from repository secrets, ON THE SELF-HOSTED RUNNER, in its
# "Render the environment file" step, and passes it to the LOCAL `docker
# compose` via --env-file. It is consumed locally and never copied to the
# staging host: compose reads it on the runner and sends the values to the
# host's daemon over the SSH-tunnelled Docker API as container environment, so
# no plaintext secret is ever written to the host's filesystem. The rendered
# file is deleted by the workflow's `if: always()` cleanup step, because the
# runner is persistent.
#
# This example file is documentation AND is parsed by
# deploy/trc/validate_compose.py, which fills each key with a placeholder to
# prove `docker compose config` renders. Only the KEYS are read; the values
# below are illustrative. Every variable the compose file references must be
# listed here.

# Image to deploy. The workflow builds and pushes two tags on every dispatch:
# the moving `:staging` pointer and the IMMUTABLE `:git-<7-char-sha>` naming
# the exact commit built. `PAPERCLIP_IMAGE` is rendered as the `:git-<7>` one --
# never `:staging` -- so "what is running" is unambiguous and cannot be changed
# under the deploy by a later, unrelated run. There is no separate publish
# workflow: build, push and deploy are one dispatch, so the tag always exists
# by the time compose pulls it. To roll back, follow the procedure in
# docs/deploy/trc-staging.md, which dispatches from a throwaway branch with the
# `DEPLOY_IMAGE` env line of the "Render the environment file" step hardcoded
# to an older `:git-<7>` tag.
#
# The repository was renamed from `paperclip` to `trc-paperclip`, and the
# workflow derives the GHCR package from the `IMAGE` env value, so every build
# lands under `trc-paperclip`. The old `paperclip` package is frozen history and
# is not used here. The image is built with `target: production` -- the
# Dockerfile declares a later `cloud` stage that this stack never deploys.
PAPERCLIP_IMAGE=ghcr.io/nature-technologies/trc-paperclip:git-f070113

# Secret. Postgres is unreachable from the host, so moving this off the old
# hardcoded "paperclip" is hardening rather than a fix. The same value is
# interpolated into DATABASE_URL, so both come from this one variable.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Secrets.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
#   openssl rand -hex 32
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Secret, shared with trc-hermes-agent but for an independent consumer, so no
# cross-check is needed.
OPENROUTER_API_KEY=

# The real external URL a browser can reach -- scheme, host and port as seen
# from OUTSIDE the host, e.g. http://<server-host>:3100, or the https:// origin
# if it sits behind a proxy. Baked into auth callbacks and shown to the first
# admin. A localhost value is wrong on a server.
PAPERCLIP_PUBLIC_URL=

# Absolute host path for Paperclip's instance data, bind-mounted at /paperclip.
# Holds secrets/master.key and the instance config.json that carries the
# hermes_gateway wiring -- treat it as irreplaceable. Must be owned by UID 1000
# (`node`), because bind mounts carry host ownership straight through and the
# container does not run as root.
PAPERCLIP_HOME_DIR=/srv/trc/staging/paperclip-home

# Host bind address. Reachable on any host interface by default.
PAPERCLIP_BIND=0.0.0.0
